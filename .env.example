# Dashboard and service. This app uses port 8766 so it does not clash with another tracker.
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8766
TRACKER_DATA_DIR=~/.local/share/cursor-only-activity-tracker

# Folders that contain your projects. Use absolute paths, separated by commas.
TRACKER_WORKSPACE_ROOTS=~/htdocs
TRACKER_SCAN_INTERVAL=30
TRACKER_IDLE_THRESHOLD_SECONDS=300
TRACKER_EXCLUDE_DIRS=.git,node_modules,vendor,.venv,venv,dist,build,.next,.idea

# Timelog source. Leave these commented to use the installed Cursor Timelog MCP.
# Install that MCP first. See cursor-timelog-mcp/INSTALL.md.
# ACTIVITY_MCP_COMMAND=
# ACTIVITY_MCP_ARGS=-m cursor_timelog.server
# ACTIVITY_MCP_PYTHONPATH=
# ACTIVITY_MCP_TOOL=generate_timelog
